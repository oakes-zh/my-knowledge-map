# ========== Dify Configuration ==========
# Your Dify instance URL (default: http://localhost:3000 for local Docker)
DIFY_BASE_URL=http://localhost:3000/v1

# Knowledge Dataset API Key (get from Dify: Knowledge -> API)
DIFY_KNOWLEDGE_API_KEY=dataset-xxxxxxxxxxxx

# Chat App API Key (get from Dify: App -> API Access)
DIFY_CHAT_API_KEY=app-xxxxxxxxxxxx

# Dataset ID (get from Dify Knowledge URL)
DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ========== Backend Service ==========
BACKEND_PORT=8900
BACKEND_HOST=0.0.0.0

# ========== Frontend ==========
FRONTEND_PORT=3100

# ========== LLM for Preprocessing (summarize, tagging) ==========
# Use Dify's LLM or direct API
LLM_PROVIDER=dify  # options: dify | openai | deepseek
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ========== OCR ==========
# PaddleOCR or Tesseract
OCR_ENGINE=paddle  # options: paddle | tesseract
OCR_LANG=ch

# ========== File Storage ==========
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=20
